{
  "text-color": "#1B1B1B",
  "background-color": "#F0F0EE",
  "line-number-color": "#9A9A9A",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword": { "text-color": "#501D83", "bold": true, "italic": false, "underline": false },
    "ControlFlow": { "text-color": "#501D83", "bold": true, "italic": false, "underline": false },
    "DataType": { "text-color": "#501D83", "bold": false, "italic": false, "underline": false },
    "Import": { "text-color": "#501D83", "bold": false, "italic": false, "underline": false },
    "DecVal": { "text-color": "#CF4527", "bold": false, "italic": false, "underline": false },
    "BaseN": { "text-color": "#CF4527", "bold": false, "italic": false, "underline": false },
    "Float": { "text-color": "#CF4527", "bold": false, "italic": false, "underline": false },
    "Constant": { "text-color": "#CF4527", "bold": false, "italic": false, "underline": false },
    "Char": { "text-color": "#00788E", "bold": false, "italic": false, "underline": false },
    "SpecialChar": { "text-color": "#00788E", "bold": false, "italic": false, "underline": false },
    "String": { "text-color": "#00788E", "bold": false, "italic": false, "underline": false },
    "VerbatimString": { "text-color": "#00788E", "bold": false, "italic": false, "underline": false },
    "SpecialString": { "text-color": "#00788E", "bold": false, "italic": false, "underline": false },
    "Function": { "text-color": "#0057BF", "bold": false, "italic": false, "underline": false },
    "BuiltIn": { "text-color": "#0057BF", "bold": false, "italic": false, "underline": false },
    "Other": { "text-color": "#0057BF", "bold": false, "italic": false, "underline": false },
    "Extension": { "text-color": "#0057BF", "bold": false, "italic": false, "underline": false },
    "Attribute": { "text-color": "#007838", "bold": false, "italic": false, "underline": false },
    "Variable": { "text-color": "#1B1B1B", "bold": false, "italic": false, "underline": false },
    "Operator": { "text-color": "#58595B", "bold": false, "italic": false, "underline": false },
    "Comment": { "text-color": "#6E6E70", "bold": false, "italic": true, "underline": false },
    "Documentation": { "text-color": "#6E6E70", "bold": false, "italic": true, "underline": false },
    "Annotation": { "text-color": "#6E6E70", "bold": false, "italic": true, "underline": false },
    "CommentVar": { "text-color": "#6E6E70", "bold": false, "italic": true, "underline": false },
    "Information": { "text-color": "#6E6E70", "bold": false, "italic": true, "underline": false },
    "Preprocessor": { "text-color": "#007838", "bold": false, "italic": false, "underline": false },
    "RegionMarker": { "text-color": "#58595B", "bold": false, "italic": false, "underline": false },
    "Warning": { "text-color": "#C20019", "bold": false, "italic": true, "underline": false },
    "Alert": { "text-color": "#C20019", "bold": true, "italic": false, "underline": false },
    "Error": { "text-color": "#C20019", "bold": true, "italic": false, "underline": false }
  }
}
